# FinBot - Exemplo de Variáveis de Ambiente
# FASE 0 (Foundation): Nenhuma chave real ou exchange necessária.
# NUNCA insira chaves reais neste arquivo ou versione arquivos .env

# Modo de Operação (MONITOR, BACKTEST, PAPER, LIVE)
# LIVE é estritamente bloqueado por padrão.
FINBOT_MODE=MONITOR

# Configurações de Execução
FINBOT_LOG_LEVEL=INFO
