# FinBot - Exemplo de Variáveis de Ambiente
# FASE 8.1 (Binance Private Integration Foundation)
# NUNCA insira chaves reais neste arquivo e NUNCA versione arquivos .env

# Modo de Trading da Aplicação (paper, live)
# Default obrigatório: paper. Live trading de ordens permanece bloqueado na Fase 8.1.
TRADING_MODE=paper

# Configurações de Execução e Log
FINBOT_LOG_LEVEL=INFO

# Credenciais da Binance (necessárias exclusivamente se TRADING_MODE=live para leitura)
# ATENÇÃO: Na Fase 8.1, use APENAS permissões de LEITURA de conta/saldos na Binance.
# NUNCA habilite permissões de Spot Trading nem Withdrawal (saques).
BINANCE_API_KEY=
BINANCE_API_SECRET=
