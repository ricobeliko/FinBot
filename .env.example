# FinBot - Exemplo de Variáveis de Ambiente
# FASE 8.2A (Secure Windows Credential Storage)
# NUNCA insira chaves reais neste arquivo e NUNCA versione arquivos .env

# Modo de Trading da Aplicação (paper, live)
# Default obrigatório: paper. Live trading de ordens permanece categoricamente bloqueado.
TRADING_MODE=paper

# Configurações de Execução e Log
FINBOT_LOG_LEVEL=INFO

# =============================================================================
# ARMAZENAMENTO DE CREDENCIAIS REAIS (PC FORTE / PRODUÇÃO):
# =============================================================================
# As credenciais reais de API da Binance NÃO são lidas deste arquivo nem de
# variáveis de ambiente do sistema operacional.
#
# A única fonte autorizada para credenciais de produção no PC Forte é o
# WINDOWS CREDENTIAL MANAGER, acessado de forma segura e protegida.
#
# Para cadastrar as credenciais da Binance no Windows Credential Manager:
#   python -m finbot.credentials setup
#
# Para verificar se as credenciais estão cadastradas:
#   python -m finbot.credentials status
#
# Para remover com segurança (exige confirmação):
#   python -m finbot.credentials remove
#
# NUNCA armazene credenciais reais em arquivos .env, json, csv, sqlite ou código.
# =============================================================================
