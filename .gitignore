# Virtual environment
.venv/
env/
venv/
ENV/

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class

# Environment variables & secrets
.env
.env.*
!.env.example

# Testing & linting caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Logs & database files
logs/*.log
!logs/.gitkeep
data/*.db
data/*.sqlite
data/*.sqlite3
!data/.gitkeep
data/lab/results/*.csv
data/lab/results/*.json
!data/lab/results/.gitkeep

# Distribution / packaging
dist/
build/
*.egg-info/

# IDE & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
